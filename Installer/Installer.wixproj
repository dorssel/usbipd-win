<Project Sdk="WixToolset.Sdk">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <OutputName>$(Product)</OutputName>
    <Pedantic>true</Pedantic>
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Usbipd\Usbipd.csproj" Publish="true" />
    <ProjectReference Include="..\Usbipd.PowerShell\Usbipd.PowerShell.csproj" Publish="true" />
  </ItemGroup>
  <ItemGroup>
    <BindPath Include="..\Usbipd\bin\publish\$(Platform)" />
    <BindPath Include="..\Usbipd.PowerShell\bin\publish" />
  </ItemGroup>
  <Target Name="SetTarget" DependsOnTargets="GetBuildVersion" AfterTargets="VersioningFixups" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Version detected as $(NuGetPackageVersion)" />
    <PropertyGroup>
      <!--
      Now that we have determined the version, augment the OutputName to include the version number.
      -->
      <TargetName>$(OutputName)_$(NuGetPackageVersion)_$(Platform.ToLowerInvariant())</TargetName>
      <TargetFileName>$(TargetName)$(TargetExt)</TargetFileName>
      <TargetPath>$(TargetDir)$(TargetFileName)</TargetPath>
      <TargetPdbFileName>$(TargetName).wixpdb</TargetPdbFileName>
      <TargetPdbPath>$(TargetPdbDir)$(TargetPdbFileName)</TargetPdbPath>

      <BuildVersionMajor>$([System.Version]::Parse('$(BuildVersion)').Major)</BuildVersionMajor>
      <BuildVersionMinor>$([System.Version]::Parse('$(BuildVersion)').Minor)</BuildVersionMinor>
      <BuildVersionBuild>$([System.Version]::Parse('$(BuildVersion)').Build)</BuildVersionBuild>

      <DefineConstants>$(DefineConstants);Product=$(Product)</DefineConstants>
      <DefineConstants>$(DefineConstants);Company=$(Company)</DefineConstants>
      <DefineConstants>$(DefineConstants);Copyright=$(Copyright)</DefineConstants>
      <DefineConstants>$(DefineConstants);NuGetPackageVersion=$(NuGetPackageVersion)</DefineConstants>
      <DefineConstants>$(DefineConstants);BuildVersion3Components=$(BuildVersion3Components)</DefineConstants>
      <!--
      This ensures that each x.y.z version has a different ProductCode, so every update is a MajorUpgrade.
      It also ensures that 2 builds of the same x.y.z version will never be installed simultaneously.
      The alternative (WiX AllowSameVersionUpgrades) causes ICE61.
      -->
      <DefineConstants>$(DefineConstants);ProductCode=EA1D5623-E6A7-4E4A-9259-E39722$([System.Byte]::Parse($(BuildVersionMajor)).ToString(X2))$([System.Byte]::Parse($(BuildVersionMinor)).ToString(X2))$([System.Byte]::Parse($(BuildVersionBuild)).ToString(X2))</DefineConstants>
    </PropertyGroup>
  </Target>
  <Target Name="AssumePublishedDependencies" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Making installer for (assumed) pre-published Usbipd and Usbipd.PowerShell" />
  </Target>
</Project>