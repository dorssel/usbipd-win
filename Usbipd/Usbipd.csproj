<Project Sdk="Microsoft.NET.Sdk.Worker">

  <Import Project="../Platform.Build.props" />

  <PropertyGroup>
    <TargetFramework>$(MainTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPublishable>true</IsPublishable>
    <PublishAot>true</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <OptimizationPreference>Speed</OptimizationPreference>

    <AssemblyName>usbipd</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ProjectDir" />
    <CompilerVisibleProperty Include="IntermediateOutputPath" />
    <CompilerVisibleProperty Include="Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win32ResourceGenerator\Win32ResourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

  <Target Name="SetWin32Resource" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <Win32Resource>$(IntermediateOutputPath)generated\Win32ResourceGenerator\Resources.res</Win32Resource>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\Usbipd.Automation\*.cs" LinkBase="Usbipd.Automation" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="NativeMethods.json" />
    <Content Remove="packages.lock.json" />
    <None Include="packages.lock.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\COPYING.md" Link="COPYING.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Usbipd.Automation\usb.ids" Link="usb.ids" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- (generated) event provider manifest -->
    <Content
      Include="$(IntermediateOutputPath)generated\Win32ResourceGenerator\EventManifest.xml"
      Link="EventManifest.xml"
      CopyToOutputDirectory="PreserveNewest"
      />
  </ItemGroup>

  <Target Name="CopyManifestOnPublishNoBuild" AfterTargets="Publish">
    <Copy
      SourceFiles="$(IntermediateOutputPath)generated\Win32ResourceGenerator\EventManifest.xml"
      DestinationFiles="$(PublishDir)EventManifest.xml"
      SkipUnchangedFiles="true"
      />
  </Target>

  <ItemGroup>
    <!-- WSL -->
    <!-- Copy everything at the top level only, except the REUSE .license files (if any). -->
    <None Remove="WSL\**\*" />
    <Content Include="WSL\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="WSL\*.license" />
    <!-- Also copy everything in the platform directory moving it to the top level, except the REUSE .license files (if any). -->
    <Content Include="WSL\$(Platform)\*" Link="WSL\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="WSL\$(Platform)\*.license" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drivers -->
    <!-- Copy everything at the top level only, except the REUSE .license files (if any). -->
    <Content Include="..\Drivers\*" Link="Drivers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="..\Drivers\*.license" />
    <!-- Also copy everything in the platform directory moving it to the top level, except the REUSE .license files (if any). -->
    <Content Include="..\Drivers\$(Platform)\*" Link="Drivers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="..\Drivers\$(Platform)\*.license" />
  </ItemGroup>

</Project>
