#ifdef APSTUDIO_INVOKED
#error This file is not editable with the visual studio resource editor.
#endif


// Instead of pulling in the entire Windows SDK, we can just define the constants we need here.

#define LANG_NEUTRAL 0x00
#define SUBLANG_NEUTRAL 0x00

#define RT_MANIFEST 24

// app.manifest is provided by the main (compiling) project.

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
1 RT_MANIFEST "app.manifest"

// This we generate ourselves from VersionInfoTemplate.rc2.
#include "VersionInfo.rc"

// This one is generated by mc.exe, after we generated EventManifest.xml from EventManifestTemplate.xml.
#include "EventManifest.rc"
